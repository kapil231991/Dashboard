{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "baseUrl": "./",
    "paths": {
      "@app/todo/*": [
        "projects/todo/src/app/*"
      ],
      "@app/notes/*": [
        "projects/notes/src/app/*"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./projects/accounts/tsconfig.app.json"
    },
    {
      "path": "./projects/accounts/tsconfig.spec.json"
    },
    {
      "path": "./projects/todo/tsconfig.app.json"
    },
    {
      "path": "./projects/todo/tsconfig.spec.json"
    },
    {
      "path": "./projects/notes/tsconfig.app.json"
    },
    {
      "path": "./projects/strategy/tsconfig.app.json"
    }
  ]
}